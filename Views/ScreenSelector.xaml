<Window x:Class="QuickTrans.Views.ScreenSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择识别区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#59000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Canvas x:Name="Root" Background="Transparent">

        <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                   Stroke="#3B5BA8" StrokeThickness="2"
                   Fill="#264A90E2" SnapsToDevicePixels="True" />

        <Border x:Name="HintBox" Background="#CC1A1A1E" CornerRadius="8"
                Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,60,0,0">
            <StackPanel>
                <TextBlock Text="拖动框选要识别的区域" Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" />
                <TextBlock Text="松开鼠标开始识别 · 按 Esc 取消" Foreground="#B0B0B8"
                           FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Canvas>
</Window>
