<Window x:Class="QuickTrans.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 QuickTrans" Width="560" Height="460"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 三页内容，靠 Visibility 切换 -->
        <Grid Grid.Row="0" Margin="40,36,40,0">

            <StackPanel x:Name="Page1">
                <TextBlock Text="选中文字，按 Ctrl+Q" FontSize="22" FontWeight="SemiBold"
                           Foreground="#1A1A1E" />
                <TextBlock Margin="0,14,0,0" FontSize="13.5" Foreground="#4A4A54"
                           TextWrapping="Wrap" LineHeight="24"
                           Text="在任何软件里选中一段文字，按下 Ctrl+Q，译文会出现在选中文字的下面。" />

                <Border Background="White" CornerRadius="8" Padding="16,14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="✻  浮窗不会抢走焦点，也不会误关" FontSize="12.5" Foreground="#1A1A1E" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#6B6B75"
                                   TextWrapping="Wrap"
                                   Text="选区保持原样，继续滚动或点击当前窗口不会关掉浮窗；切到其它软件后 5 秒自动关闭（悬停可暂停）。" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,0" FontSize="12.5" Foreground="#4A4A54"
                           TextWrapping="Wrap"
                           Text="按住浮窗任意空白或译文区域可拖动；再按一次 Ctrl+Q 或 Esc 可手动关闭。" />
            </StackPanel>

            <StackPanel x:Name="Page2" Visibility="Collapsed">
                <TextBlock Text="截图、手输，都能翻" FontSize="22" FontWeight="SemiBold"
                           Foreground="#1A1A1E" />
                <TextBlock Margin="0,14,0,0" FontSize="13.5" Foreground="#4A4A54"
                           TextWrapping="Wrap" LineHeight="24"
                           Text="除了划词，还有两种入口：" />

                <Border Background="White" CornerRadius="8" Padding="16,14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="🖼  截图翻译  ·  Alt+S" FontSize="12.5" Foreground="#1A1A1E" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#6B6B75"
                                   TextWrapping="Wrap"
                                   Text="框选屏幕上的任意区域，调用系统离线 OCR 识别文字再翻译。适合图片、视频字幕、不能复制的界面。" />
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="⌨  手动输入  ·  没选中文字时按 Ctrl+Q" FontSize="12.5" Foreground="#1A1A1E" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#6B6B75"
                                   TextWrapping="Wrap"
                                   Text="浮窗变成输入框，可直接打字或粘贴多段文本，按 Ctrl+Enter 翻译，改完可反复重译。" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,0" FontSize="12.5" Foreground="#4A4A54"
                           TextWrapping="Wrap"
                           Text="浮窗操作栏可一键切换目标语言、离线朗读（再点即停）或复制译文。" />
            </StackPanel>

            <StackPanel x:Name="Page3" Visibility="Collapsed">
                <TextBlock Text="准备翻译模型或在线接口" FontSize="22" FontWeight="SemiBold"
                           Foreground="#1A1A1E" />
                <TextBlock Margin="0,14,0,0" FontSize="13.5" Foreground="#4A4A54"
                           TextWrapping="Wrap" LineHeight="24"
                           Text="本地翻译全程离线免费，首次使用只需下载一个模型（也可改用在线 API）：" />

                <Border Background="White" CornerRadius="8" Padding="16,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="📦  下载本地模型（推荐）" FontSize="12.5" Foreground="#1A1A1E" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#6B6B75"
                                   TextWrapping="Wrap"
                                   Text="在「组件管理」中下载 Qwen3-0.6B（609MB，阿里源直连）或 Hy-MT2-1.8B（1.06GB，翻译质量最稳）。" />
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="AccelTitle" Text="⚡  已内置 GPU 通用加速" FontSize="12.5" Foreground="#1A1A1E" />
                        <TextBlock x:Name="AccelDesc" Margin="0,6,0,0" FontSize="12" Foreground="#6B6B75"
                                   TextWrapping="Wrap"
                                   Text="支持 NVIDIA / AMD / Intel 显卡自动加速，也可在设置里随时切回 CPU。不想下模型也可在设置里配置 DeepSeek / 百度 / 有道 / 谷歌接口。" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0" FontSize="12.5" Foreground="#4A4A54"
                           TextWrapping="Wrap"
                           Text="以上入口随时可在「设置 → 关于与更新」里重新打开。首次翻译时按需加载模型，待机更省内存。" />
            </StackPanel>
        </Grid>

        <!-- 底部：进度点 + 按钮 -->
        <Grid Grid.Row="1" Margin="40,0,40,28">
            <StackPanel x:Name="DotPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="跳过" Padding="16,6" FontSize="12.5"
                        Cursor="Hand" Click="OnSkipClick"
                        Background="Transparent" BorderThickness="0" Foreground="#8A8A93" />
                <Button x:Name="PrevButton" Content="上一步" Padding="18,6" FontSize="12.5"
                        Margin="6,0,0,0" Cursor="Hand" Click="OnPrevClick"
                        Background="#F2F2F5" BorderThickness="0" Foreground="#3A3A44" />
                <Button x:Name="NextButton" Content="下一步" Padding="20,6" FontSize="12.5"
                        Margin="8,0,0,0" Cursor="Hand" Click="OnNextClick"
                        Background="#3B5BA8" BorderThickness="0" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
