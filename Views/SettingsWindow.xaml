<Window x:Class="QuickTrans.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTrans 设置"
        Width="740" Height="660"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFB"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E8E8EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#1A1A1E" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#8A8A93" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="BorderBrush" Value="#DEDEE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B5BA8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MainScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,18,20,4">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="翻译通道" Style="{StaticResource SectionTitle}" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LocalRadio" Content="本地模型" GroupName="engine"
                                         IsChecked="True" VerticalAlignment="Center" FontSize="12.5"
                                         Checked="OnEngineChanged" />
                            <RadioButton x:Name="ApiRadio" Content="在线接口" GroupName="engine"
                                         Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                         Checked="OnEngineChanged" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="本地模型不联网、无限量、响应通常在 100–300ms。在线接口适合你在别处已有 API Key 的情况。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="本地模型" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RefreshButton" Content="刷新列表" Style="{StaticResource FlatButton}"
                                        Click="OnRefreshClick" />
                                <Button Content="打开模型文件夹" Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                        Click="OnOpenModelsFolder" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="把任意 .gguf 文件放进 models 文件夹，点刷新就能看到。删除文件即可移除模型。" />

                        <Border BorderBrush="#EDEDF1" BorderThickness="1" CornerRadius="8" Background="#FCFCFD"
                                MinHeight="120" MaxHeight="230">
                            <ListBox x:Name="ModelList" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                           Foreground="#1A1A1E" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="#8A8A93" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#EEF2FB" CornerRadius="4"
                                                    Padding="6,2" Margin="8,0" VerticalAlignment="Center"
                                                    Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10.5" Foreground="#3B5BA8" />
                                            </Border>

                                            <Button Grid.Column="2" Content="使用"
                                                    Style="{StaticResource FlatButton}"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="OnUseModelClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock x:Name="EngineStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="正在检查引擎…" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="模型加载策略" Style="{StaticResource SectionTitle}" />

                        <StackPanel x:Name="DevicePanel" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="推理设备" FontSize="12.5" VerticalAlignment="Center" />
                            <RadioButton x:Name="GpuRadio" Content="GPU（快，占显存）" GroupName="device"
                                         FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="CpuRadio" Content="CPU（慢，不占显存）" GroupName="device"
                                         FontSize="12.5" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="EngineVariantPanel" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="引擎版本" FontSize="12.5" VerticalAlignment="Center" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="EngineVariantBox" Width="240" Margin="14,0,0,0"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="GPU 版（含 CUDA，可选 CPU/GPU）" />
                                <ComboBoxItem Content="CPU 版（精简 62MB，只能 CPU）" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="EngineVariantHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="改引擎版本会卸载当前模型，下次翻译用新引擎重新加载。CPU 版没有 CUDA 组件，只能跑 CPU。" />

                        <CheckBox x:Name="AutoStartBox" Content="开机自动启动（随系统登录运行）"
                                  FontSize="12.5" Margin="0,14,0,0" />

                        <RadioButton x:Name="KeepLoadedRadio" GroupName="unload" FontSize="12.5"
                                     Content="一直保留在显存里（响应最快）" Margin="0,0,0,8" />
                        <RadioButton x:Name="UnloadOnCloseRadio" GroupName="unload" FontSize="12.5"
                                     Content="浮窗关闭后立即卸载（下次翻译要重新加载，约 2–3 秒）"
                                     Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="UnloadIdleRadio" GroupName="unload" FontSize="12.5"
                                         Content="闲置" VerticalAlignment="Center"
                                         Checked="OnUnloadPolicyChanged" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="UnloadMinutesBox" Width="88" Margin="8,0,8,0"
                                      IsEditable="True" VerticalContentAlignment="Center" />
                            <TextBlock Text="分钟后卸载" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="以 0.5 分钟为最小单位。卸载后显存立即释放，下次翻译会重新加载模型。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="浮窗外观" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="不透明度" FontSize="12"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1" PreviewMouseWheel="OnComboWheel" x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    ValueChanged="OnOpacityChanged" />
                            <TextBlock Grid.Column="2" x:Name="OpacityLabel" Text="100%"
                                       FontSize="12" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="只调整浮窗的背板透明度，文字始终保持完全不透明、清晰可读。调低后能看清背后的原文。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="托盘图标" FontSize="12"
                                       VerticalAlignment="Center" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="IconStyleBox" Width="220"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="① 圆形 · 译（默认）" />
                                <ComboBoxItem Content="② 双向箭头" />
                                <ComboBoxItem Content="③ 对话气泡" />
                                <ComboBoxItem Content="④ 文 A 双色" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="改完保存会立即切换托盘图标；exe 文件本身的图标需要重新打包才会变。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="在线接口（可选）" Style="{StaticResource SectionTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="已保存接口" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="ProfileBox" Width="150" Margin="12,0,0,0"
                                      SelectionChanged="OnProfileChanged" />
                            <TextBlock Text="名称" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBox x:Name="ProfileNameBox" Width="130" Margin="6,0,0,0"
                                     ToolTip="给这套接口起个名字，改完点保存即可重命名" />
                            <Button Content="新建" FontSize="11.5" Padding="12,4" Margin="8,0,0,0"
                                    Cursor="Hand" Click="OnNewProfileClick" />
                            <Button Content="删除" FontSize="11.5" Padding="12,4" Margin="6,0,0,0"
                                    Cursor="Hand" Click="OnDeleteProfileClick" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="接口类型" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="ApiTypeBox" Width="250" Margin="12,0,0,0"
                                      SelectionChanged="OnApiTypeChanged">
                                <ComboBoxItem Content="OpenAI 兼容（DeepSeek / 智谱 / 自建）" />
                                <ComboBoxItem Content="百度翻译开放平台" />
                                <ComboBoxItem Content="有道智云" />
                                <ComboBoxItem Content="谷歌翻译（免费端点，需能访问）" />
                            </ComboBox>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ApiUrlLabel" Text="Base URL" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApiUrlBox" Margin="0,0,0,8"
                                     ToolTip="例如 https://api.deepseek.com/v1" />

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ApiKeyLabel" Text="API Key" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="ApiModelLabel" Text="模型名" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ApiModelBox" />
                        </Grid>

                        <TextBlock x:Name="ApiHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="填任何 OpenAI 兼容接口都行：DeepSeek、智谱、DeepL 代理、公司网关。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="语音朗读" Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="TtsEnabledBox" FontSize="12.5" Margin="0,0,0,10"
                                  Content="在浮窗上显示朗读按钮（🔊）" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="中文音色" FontSize="12.5" VerticalAlignment="Center" Width="62" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="TtsVoiceZhBox"
                                      Width="230" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="英文音色" FontSize="12.5" VerticalAlignment="Center" Width="62" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="TtsVoiceEnBox"
                                      Width="230" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="语速" FontSize="12.5" VerticalAlignment="Center" />
                            <Slider x:Name="TtsRateSlider" PreviewMouseWheel="OnComboWheel"
                                    Minimum="-50" Maximum="100" Value="0" Width="200"
                                    Margin="14,0,0,0" VerticalAlignment="Center"
                                    ValueChanged="OnTtsRateChanged" />
                            <TextBlock x:Name="TtsRateLabel" FontSize="12" Foreground="#6B6B75"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Text="常速" />
                        </StackPanel>

                        <TextBlock x:Name="TtsHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="使用 Windows 自带的语音包，完全离线。想加更多声音，在「设置 → 时间和语言 → 语音」里添加。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="使用方式" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="划词热键" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="HotkeyBox" Width="160" IsReadOnly="True"
                                         PreviewKeyDown="OnHotkeyKeyDown" />
                                <TextBlock Text="点这里再按组合键" FontSize="11" Foreground="#A0A0A8"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="截图热键" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="OcrHotkeyBox" Width="160" IsReadOnly="True"
                                         PreviewKeyDown="OnHotkeyKeyDown" />
                                <TextBlock Text="框选屏幕区域做 OCR" FontSize="11" Foreground="#A0A0A8"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="默认目标语言" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Row="2" Grid.Column="1" x:Name="LanguageBox" Width="180"
                                      HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="取词方式" FontSize="12"
                                       VerticalAlignment="Center" />
                            <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Row="3" Grid.Column="1" x:Name="GrabModeBox" Width="240"
                                      HorizontalAlignment="Left" />
                        </Grid>

                        <CheckBox x:Name="AutoDirectionBox" FontSize="12.5" Margin="0,12,0,0"
                                  Content="自动判断方向：选中中文译成英语，选中其他语言译成上面的默认目标语言" />

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="自动模式会用 UI Automation 直接读选区，读不到才模拟 Ctrl+C。遇到某些应用取词不准时，可切到「仅剪贴板」。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="浮窗上的快捷语言" Style="{StaticResource SectionTitle}" />

                        <ItemsControl x:Name="LangCheckList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                              FontSize="12.5" Margin="0,0,16,7" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="勾选的语言会出现在浮窗底部，点击即可切换并重新翻译当前文本。建议选 3–5 个。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8EC" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="SaveHint" FontSize="11.5" Foreground="#8A8A93" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource FlatButton}" Padding="16,7"
                            Click="OnCancelClick" />
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
