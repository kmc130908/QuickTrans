<Window x:Class="QuickTrans.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:v="clr-namespace:QuickTrans.Views"
        Title="QuickTrans 设置"
        Width="860" Height="670"
        MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource UiFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushWindowBg" Color="#F5F6FA" />
        <SolidColorBrush x:Key="BrushSidebarBg" Color="#EEF0F6" />
        <SolidColorBrush x:Key="BrushCardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushSubPanelBg" Color="#F2F4F8" />
        <SolidColorBrush x:Key="BrushBorder" Color="#D4D8E4" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#14151A" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#3A3D4A" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#646876" />
        <SolidColorBrush x:Key="BrushAccent" Color="#2F54A8" />
        <SolidColorBrush x:Key="BrushAccentSoft" Color="#E6EEFD" />
        <SolidColorBrush x:Key="BrushPillBg" Color="#EBEDF4" />
        <SolidColorBrush x:Key="BrushPillHover" Color="#DFE3EE" />
        <SolidColorBrush x:Key="BrushInputBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushDivider" Color="#E2E5EE" />

        <!-- 动态字号阶梯（随界面字体大小设置同步缩放） -->
        <sys:Double x:Key="FontSizeXs">11.5</sys:Double>
        <sys:Double x:Key="FontSizeHint">12.0</sys:Double>
        <sys:Double x:Key="FontSizeSm">12.5</sys:Double>
        <sys:Double x:Key="FontSizeBase">13.5</sys:Double>
        <sys:Double x:Key="FontSizeSection">14.5</sys:Double>
        <sys:Double x:Key="FontSizeHeader">20.0</sys:Double>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SubGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHeader}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Margin" Value="2,0,0,14" />
        </Style>

        <!-- 普通备注文本 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18.5" />
        </Style>

        <!-- 复选框/单选框下方对齐缩进的说明 -->
        <Style x:Key="InlineHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="24,3,0,10" />
        </Style>

        <!-- 卡片底部强调型备注容器 -->
        <Style x:Key="NoteBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSubPanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="SubPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSubPanelBg}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 现代圆角 CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.25"
                                    VerticalAlignment="Center" Margin="0,1,8,1">
                                <Path x:Name="CheckMark" Data="M3.5,8.2 L6.6,11.3 L12.5,4.8"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代圆角 RadioButton -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Circle" Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource BrushInputBg}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.25"
                                    VerticalAlignment="Center" Margin="0,1,8,1">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="White" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航按钮（BorderBrush 作为选中竖条颜色控制） -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9.5" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{TemplateBinding BorderBrush}" Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角文本框（避免 Border 与内部 TextBox 双重 Padding 撑高错位，统一 34px 高度） -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushTextMuted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题自适应圆角 ComboBox（PART_EditableTextBox 用极简无边框模板，与 TextBox 同为 34px 高且左对齐） -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPillHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" MinHeight="{TemplateBinding MinHeight}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Visibility="Collapsed"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{DynamicResource BrushTextPrimary}"
                                             Margin="10,0,2,0" Padding="0"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             HorizontalContentAlignment="Left"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"
                                                              VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <v:VectorIcon Grid.Column="1" Data="{StaticResource IconChevronDown}" Size="13"
                                                  Foreground="{DynamicResource BrushTextMuted}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Bd}"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border x:Name="PART_DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,6" Padding="0,4" CornerRadius="8"
                                        Background="{DynamicResource BrushCardBg}"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                    <ScrollViewer x:Name="PART_DropDownScrollViewer"
                                                  SnapsToDevicePixels="True" CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushTextMuted}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代圆角滑块 -->
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource BrushBorder}"
                                    VerticalAlignment="Center" Margin="6,0" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource BrushAccent}"
                                                        VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Knob" Width="15" Height="15" CornerRadius="7.5"
                                                        Background="{DynamicResource BrushAccent}"
                                                        BorderBrush="{DynamicResource BrushCardBg}" BorderThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="17" />
                                                        <Setter TargetName="Knob" Property="Height" Value="17" />
                                                        <Setter TargetName="Knob" Property="CornerRadius" Value="8.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPillBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPillHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,7.5" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类导航 -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18" VerticalAlignment="Center">
                        <Image x:Name="BrandLogoImage" Width="34" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="QuickTrans" FontFamily="{StaticResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="偏好设置" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <Button x:Name="NavGeneral" Style="{StaticResource NavButton}" Tag="0" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <v:VectorIcon Data="{StaticResource IconSliders}" Size="15.5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="常规与热键" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavModel" Style="{StaticResource NavButton}" Tag="1" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <v:VectorIcon Data="{StaticResource IconCpu}" Size="15.5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="模型与引擎" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavApi" Style="{StaticResource NavButton}" Tag="2" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <v:VectorIcon Data="{StaticResource IconGlobe}" Size="15.5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="在线接口" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPopup" Style="{StaticResource NavButton}" Tag="3" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <v:VectorIcon Data="{StaticResource IconPalette}" Size="15.5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="浮窗与外观" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDnd" Style="{StaticResource NavButton}" Tag="4" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <v:VectorIcon Data="{StaticResource IconBellOff}" Size="15.5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="免打扰" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="5" Click="OnNavClick">
                            <StackPanel Orientation="Horizontal">
                                <v:VectorIcon Data="{StaticResource IconVolume}" Size="15.5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="朗读与关于" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧模块化内容 -->
            <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,12">
                <Grid>

                    <!-- ==================== 0. 常规与热键 ==================== -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="常规与热键" Style="{StaticResource PageHeader}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="翻译通道" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LocalRadio" Content="本地模型（离线免费）" GroupName="engine"
                                                 IsChecked="True" VerticalAlignment="Center"
                                                 Checked="OnEngineChanged" />
                                    <RadioButton x:Name="ApiRadio" Content="在线接口" GroupName="engine"
                                                 Margin="24,0,0,0" VerticalAlignment="Center"
                                                 Checked="OnEngineChanged" />
                                </StackPanel>
                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="本地模型不联网、无限量，GPU 响应约 100–300ms；在线接口适合已有 API Key 或不想下载本地模型的场景。" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="快捷键与触发" Style="{StaticResource SectionTitle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="192" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="划词翻译" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyBox" Width="180" HorizontalAlignment="Left"
                                             FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"
                                             PreviewKeyDown="OnHotkeyKeyDown" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,10"
                                               Text="点输入框后按组合键；未选文字时打开手动输入" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="截图翻译" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="OcrHotkeyBox" Width="180" HorizontalAlignment="Left"
                                             FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"
                                             PreviewKeyDown="OnHotkeyKeyDown" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,10"
                                               Text="框选任意显示器区域做离线 OCR 翻译" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="替换翻译" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReplaceHotkeyBox" Width="180" HorizontalAlignment="Left"
                                             FontFamily="{StaticResource MonoFont}"
                                             PreviewKeyDown="OnHotkeyKeyDown" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="翻译当前选中的文字并直接粘贴替换原文" />
                                </Grid>

                                <CheckBox x:Name="DoubleCtrlCBox" Margin="0,14,0,0"
                                          Content="快速连按两次 Ctrl+C 触发划词翻译" />
                                <TextBlock Style="{StaticResource InlineHint}" Margin="24,3,0,0"
                                           Text="选中文本后连续快速按两次 Ctrl+C 即可翻译，不影响单次正常复制。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="语言与取词" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="默认目标语言" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Row="0" Grid.Column="1"
                                              x:Name="LanguageBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,10"
                                              MaxDropDownHeight="174" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="取词方式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Row="1" Grid.Column="1"
                                              x:Name="GrabModeBox" Width="260" HorizontalAlignment="Left" />
                                </Grid>

                                <CheckBox x:Name="AutoDirectionBox" Margin="0,0,0,10"
                                          Content="自动判断方向：选中中文译成英语，选中其他语言译成默认目标语言" />

                                <CheckBox x:Name="SmartJoinLinesBox"
                                          Content="自动合并 PDF / 文档中的多余断行（智能去换行）" />
                                <TextBlock Style="{StaticResource InlineHint}"
                                           Text="读论文、PDF 或截图 OCR 时自动拼接被折断的句子（保留分段与列表），翻译更连贯。" />

                                <CheckBox x:Name="WordDictBox"
                                          Content="单词词典模式：选中单个英文单词时输出音标、词性、释义与例句" />
                                <TextBlock Style="{StaticResource InlineHint}" Margin="24,3,0,0"
                                           Text="在本地模型和 OpenAI 兼容接口下生效；百度 / 有道 / 谷歌接口保持普通翻译。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="启动行为" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="AutoStartBox" Content="开机自动启动（随系统登录静默运行）" Margin="0,0,0,8" />
                                <CheckBox x:Name="ShowSettingsOnStartupBox"
                                          Content="手动启动软件时自动打开设置页" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 1. 本地模型 ==================== -->
                    <StackPanel x:Name="PageModel" Visibility="Collapsed">
                        <TextBlock Text="本地模型与推理引擎" Style="{StaticResource PageHeader}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="可用本地模型" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="添加模型…" Style="{StaticResource FlatButton}"
                                                Click="OnAddCustomModelClick" ToolTip="从电脑任意目录选择 .gguf 模型文件" />
                                        <Button x:Name="AutoScanModelsButton" Content="自动扫描" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                Click="OnAutoScanModelsClick" ToolTip="自动扫描 LM Studio / 下载文件夹 / 魔搭 / HF 缓存中的 .gguf 模型" />
                                        <Button Content="下载模型…" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                Click="OnOpenComponentsClick" ToolTip="一键多线程下载推荐离线翻译模型" />
                                        <Button Content="模型文件夹" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                Click="OnOpenModelsFolder" />
                                        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                Click="OnRefreshClick" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="安装目录 models 文件夹里的 .gguf 会自动加载；右侧留白可直接上下滚动设置页。" />

                                <!-- 按 74:26 比例收窄模型列表，窗口缩放时同步缩放并保留右侧整页滚动通道 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74*" />
                                        <ColumnDefinition Width="26*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BrushSubPanelBg}"
                                            MinHeight="110" MaxHeight="220">
                                        <ListBox x:Name="ModelList" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.CanContentScroll="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeBase}" FontWeight="Medium"
                                                                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeXs}"
                                                                       Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1" Background="{DynamicResource BrushAccentSoft}" CornerRadius="4"
                                                                Padding="7,2" Margin="8,0" VerticalAlignment="Center"
                                                                Visibility="{Binding BadgeVisibility}">
                                                            <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" />
                                                        </Border>

                                                        <Button Grid.Column="2" Content="移除"
                                                                Style="{StaticResource FlatButton}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding RemoveVisibility}"
                                                                ToolTip="仅从列表移除（不删除硬盘上的模型文件）"
                                                                Tag="{Binding}"
                                                                Click="OnRemoveCustomModelClick" />

                                                        <Button Grid.Column="3" Content="使用"
                                                                Style="{StaticResource FlatButton}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding UseVisibility}"
                                                                Tag="{Binding}"
                                                                Click="OnUseModelClick" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="EngineStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="正在检查引擎…" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="推理设备与卸载策略" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="计算设备" Style="{StaticResource SubGroupTitle}" />
                                <StackPanel x:Name="DevicePanel" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="推理设备" Style="{StaticResource FieldLabel}" Width="112" />
                                    <RadioButton x:Name="GpuRadio" Content="GPU（快，占显存）" GroupName="device"
                                                 VerticalAlignment="Center" />
                                    <RadioButton x:Name="CpuRadio" Content="CPU（慢，不占显存）" GroupName="device"
                                                 Margin="20,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel x:Name="EngineVariantPanel" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="引擎版本" Style="{StaticResource FieldLabel}" Width="112" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="EngineVariantBox" Width="260"
                                              VerticalAlignment="Center" SelectionChanged="OnEngineVariantChanged">
                                        <ComboBoxItem Content="GPU 版（CUDA / Vulkan，可选 CPU/GPU）" />
                                        <ComboBoxItem Content="CPU 版（精简 45MB，只能 CPU）" />
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock x:Name="EngineVariantHint" Style="{StaticResource Hint}" Margin="112,2,0,0"
                                           Text="切换引擎版本会卸载当前模型，下次翻译用新引擎重新加载；CPU 版无 GPU 后端。" />

                                <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="0,14" />

                                <TextBlock Text="启动加载" Style="{StaticResource SubGroupTitle}" />
                                <CheckBox x:Name="PrewarmModelBox" Content="启动软件时预加载本地模型（关闭可降低待机内存占用）" />

                                <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="0,14" />

                                <TextBlock Text="闲置卸载策略" Style="{StaticResource SubGroupTitle}" />
                                <RadioButton x:Name="KeepLoadedRadio" GroupName="unload"
                                             Content="一直保留在显存 / 内存里（响应最快）" Margin="0,0,0,8" />
                                <RadioButton x:Name="UnloadOnCloseRadio" GroupName="unload"
                                             Content="浮窗关闭后立即卸载（下次翻译重新加载约 2 秒）" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="UnloadIdleRadio" GroupName="unload"
                                                 Content="闲置" VerticalAlignment="Center"
                                                 Checked="OnUnloadPolicyChanged" Unchecked="OnUnloadPolicyChanged" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" x:Name="UnloadMinutesBox" Width="84" MinHeight="32"
                                              FontFamily="{StaticResource MonoFont}" MaxDropDownHeight="164"
                                              Margin="8,0,8,0" IsEditable="True" VerticalAlignment="Center" />
                                    <TextBlock Text="分钟后自动卸载（最小 0.5 分钟，推荐）" Style="{StaticResource FieldLabel}"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                </StackPanel>

                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="卸载后推理进程 llama-server 会完全退出，显存与模型内存全部归还系统，下次按热键时自动重新加载。" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 2. 在线接口 ==================== -->
                    <StackPanel x:Name="PageApi" Visibility="Collapsed">
                        <TextBlock Text="在线翻译接口（可选）" Style="{StaticResource PageHeader}" />

                        <!-- 已保存的接口列表 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="已保存的接口" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource FlatButton}" Click="OnNewProfileClick">
                                        <StackPanel Orientation="Horizontal">
                                            <v:VectorIcon Data="{StaticResource IconPlus}" Size="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="新建接口" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                                        Background="{DynamicResource BrushSubPanelBg}" MinHeight="64" MaxHeight="170">
                                    <Grid>
                                        <TextBlock x:Name="ApiProfileEmptyHint" Text="还没有已保存的接口，在下方填好参数后点右下角「保存」即可加入列表。"
                                                   Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="12" Visibility="Collapsed" />
                                        <ListBox x:Name="ApiProfileList" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.CanContentScroll="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 HorizontalContentAlignment="Stretch"
                                                 SelectionChanged="OnProfileListSelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="6,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBase}" FontWeight="Medium"
                                                                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeXs}"
                                                                       Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1" Background="{DynamicResource BrushAccentSoft}" CornerRadius="4"
                                                                Padding="7,2" Margin="8,0" VerticalAlignment="Center"
                                                                Visibility="{Binding ActiveVisibility}">
                                                            <TextBlock Text="当前" FontSize="{DynamicResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" />
                                                        </Border>

                                                        <Button Grid.Column="2" Content="使用"
                                                                Style="{StaticResource FlatButton}"
                                                                VerticalAlignment="Center" Margin="0,0,6,0"
                                                                Tag="{Binding}" Click="OnUseProfileRowClick" />

                                                        <Button Grid.Column="3" Content="删除"
                                                                Style="{StaticResource FlatButton}"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}" Click="OnDeleteProfileRowClick" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 接口参数编辑区（所有输入与下拉框统一水平铺满且 34px 等高对齐） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="ApiEditorTitle" Text="接口配置" Style="{StaticResource SectionTitle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="接口名称" Style="{StaticResource FieldLabel}" Margin="0,0,10,10" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProfileNameBox" Margin="0,0,0,10"
                                             ToolTip="给这套接口起个名字（例如 DeepSeek、百度翻译），保存后自动加入上方列表" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="接口类型" Style="{StaticResource FieldLabel}" Margin="0,0,10,10" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" PreviewMouseWheel="OnComboWheel" x:Name="ApiTypeBox"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                              SelectionChanged="OnApiTypeChanged">
                                        <ComboBoxItem Content="OpenAI 兼容（DeepSeek / 智谱 / 自建）" />
                                        <ComboBoxItem Content="百度翻译开放平台" />
                                        <ComboBoxItem Content="有道智云" />
                                        <ComboBoxItem Content="谷歌翻译（免费端点，需能访问）" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="ApiUrlLabel" Text="Base URL" Style="{StaticResource FieldLabel}" Margin="0,0,10,10" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ApiUrlBox" Margin="0,0,0,10"
                                             FontFamily="{StaticResource MonoFont}"
                                             ToolTip="例如 https://api.deepseek.com/v1" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" x:Name="ApiKeyLabel" Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,0,10,10" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,0,0,10"
                                             FontFamily="{StaticResource MonoFont}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" x:Name="ApiModelLabel" Text="模型名" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="ApiModelBox"
                                             FontFamily="{StaticResource MonoFont}" />
                                </Grid>

                                <TextBlock x:Name="ApiKeyHelpLink" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushAccent}"
                                           Cursor="Hand" Margin="112,12,0,0"
                                           Text="如何获取 API Key 与 Base URL？"
                                           TextDecorations="Underline"
                                           MouseLeftButtonUp="OnApiKeyHelpClick" />

                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock x:Name="ApiHint" Style="{StaticResource Hint}" LineHeight="20" Text="" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 3. 浮窗与外观 ==================== -->
                    <StackPanel x:Name="PagePopup" Visibility="Collapsed">
                        <TextBlock Text="浮窗与外观" Style="{StaticResource PageHeader}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="外观、字体与托盘" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="界面主题" Style="{StaticResource FieldLabel}" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="ThemeBox"
                                              Width="260" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="跟随 Windows 系统主题（推荐）" />
                                        <ComboBoxItem Content="浅色模式" />
                                        <ComboBoxItem Content="深色模式" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="界面字体大小" Style="{StaticResource FieldLabel}" />
                                    <Slider PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="FontScaleSlider"
                                            Minimum="0.85" Maximum="1.35" Value="1.0"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            ValueChanged="OnFontScaleChanged" />
                                    <TextBlock Grid.Column="2" x:Name="FontScaleLabel" Text="100%"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="背景不透明度" Style="{StaticResource FieldLabel}" />
                                    <Slider PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="OpacitySlider"
                                            Minimum="0.3" Maximum="1.0" Value="1.0"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            ValueChanged="OnOpacityChanged" />
                                    <TextBlock Grid.Column="2" x:Name="OpacityLabel" Text="100%"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <TextBlock Style="{StaticResource Hint}" Margin="112,4,0,12"
                                           Text="只调整浮窗背板透明度（100% 锁定纯色不透底），文字始终保持完全不透明清晰可读。" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="托盘图标" Style="{StaticResource FieldLabel}" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="IconStyleBox"
                                              Width="260" HorizontalAlignment="Left"
                                              SelectionChanged="OnIconStyleChanged">
                                        <ComboBoxItem Content="1. 极光折页（默认）" />
                                        <ComboBoxItem Content="2. 闪电双箭" />
                                        <ComboBoxItem Content="3. 灵动气泡" />
                                        <ComboBoxItem Content="4. 极简 Q 译" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="浮窗尺寸与文本框" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="浮窗宽度" Style="{StaticResource FieldLabel}" />
                                    <Slider PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="PopupWidthSlider"
                                            Minimum="460" Maximum="840" Value="580"
                                            TickFrequency="20" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            ValueChanged="OnPopupWidthChanged" />
                                    <TextBlock Grid.Column="2" x:Name="PopupWidthLabel" Text="580 px"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="原文框最大高度" Style="{StaticResource FieldLabel}" />
                                    <Slider PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="PopupSourceHeightSlider"
                                            Minimum="60" Maximum="240" Value="96"
                                            TickFrequency="12" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            ValueChanged="OnPopupSourceHeightChanged" />
                                    <TextBlock Grid.Column="2" x:Name="PopupSourceHeightLabel" Text="96 px"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="译文框最大高度" Style="{StaticResource FieldLabel}" />
                                    <Slider PreviewMouseWheel="OnComboWheel" Grid.Column="1" x:Name="PopupResultHeightSlider"
                                            Minimum="220" Maximum="680" Value="400"
                                            TickFrequency="20" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            ValueChanged="OnPopupResultHeightChanged" />
                                    <TextBlock Grid.Column="2" x:Name="PopupResultHeightLabel" Text="400 px"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="原文或译文超出最大高度时，框内会自动启用平滑滚动，不再截断长文本；同时同步作用于手动输入框高度。" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自动关闭与内存模式" Style="{StaticResource SectionTitle}" />

                                <Border Style="{StaticResource SubPanel}">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoClosePopupBox"
                                                  Content="切走来源窗口后自动关闭浮窗"
                                                  Checked="OnAutoCloseChanged" Unchecked="OnAutoCloseChanged" />

                                        <StackPanel Orientation="Horizontal" Margin="24,8,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="等待" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBox x:Name="AutoCloseSecondsBox" Width="64" MinHeight="30" Padding="4,0" Margin="8,0,8,0"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center" />
                                            <TextBlock Text="秒后关闭（0 表示切走立刻关）" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>

                                        <CheckBox x:Name="AutoCloseHoverBox" Margin="24,10,0,0"
                                                  Content="鼠标停在浮窗上时暂停倒计时" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SubPanel}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="TimedCloseBox"
                                                  Content="定时自动关闭（不切窗口也自动关）" />
                                        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                                            <TextBlock Text="显示" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBox x:Name="TimedCloseSecondsBox" Width="64" MinHeight="30" Padding="4,0" Margin="8,0,8,0"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center" />
                                            <TextBlock Text="秒后自动关闭" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource InlineHint}" Margin="24,6,0,0"
                                                   Text="翻译完成后开始计时；点击浮窗右上角钉住图标可暂停自动关闭。" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SubPanel}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="PopupIsolateBox"
                                                  Content="极低待机内存模式（翻译浮窗与截图独立子进程运行）" />
                                        <TextBlock Style="{StaticResource InlineHint}" Margin="24,5,0,0"
                                                   Text="开启：关窗后主程序待机内存回落到约 18MB，按热键约 0.4 秒弹出；关闭：同进程浮窗约 0.03 秒瞬弹，翻译后主程序常驻约 38MB。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="浮窗上的快捷语言" Style="{StaticResource SectionTitle}" />

                                <ItemsControl x:Name="LangCheckList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,18,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="勾选的语言会显示在浮窗操作栏左侧，点击即可切换目标语言并重新翻译（建议保留 3–5 个）。" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 4. 免打扰 ==================== -->
                    <StackPanel x:Name="PageDnd" Visibility="Collapsed">
                        <TextBlock Text="免打扰与热键屏蔽" Style="{StaticResource PageHeader}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="全屏场景自动屏蔽" Style="{StaticResource SectionTitle}" />

                                <CheckBox x:Name="DndGameBox"
                                          Content="全屏游戏时屏蔽所有翻译热键（划词 / 截图 / 替换 / 双击 Ctrl+C）" />
                                <TextBlock Style="{StaticResource InlineHint}"
                                           Text="自动识别独占全屏与无边框全屏游戏，避免误触快捷键；不影响常规代码编辑器和办公软件。" />

                                <CheckBox x:Name="DndVideoBox"
                                          Content="全屏视频时屏蔽所有翻译热键" />
                                <TextBlock Style="{StaticResource InlineHint}" Margin="24,3,0,0"
                                           Text="在浏览器或 PotPlayer / VLC / B站 / 爱奇艺全屏播放时生效，退出全屏立即恢复。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="应用黑名单" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    <Button Content="刷新当前运行程序" HorizontalAlignment="Right"
                                            Style="{StaticResource FlatButton}" Click="OnRefreshRunningAppsClick" />
                                </Grid>

                                <CheckBox x:Name="DndBlacklistEnabledBox" Margin="0,0,0,12"
                                          Content="启用应用黑名单（以下程序处于前台时屏蔽所有翻译热键）" />

                                <TextBlock Text="当前正在运行的程序（勾选即加入黑名单）" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,6" />

                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                                        Background="{DynamicResource BrushSubPanelBg}" MaxHeight="165" Margin="0,0,0,12">
                                    <ScrollViewer x:Name="RunningAppsScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                        <StackPanel x:Name="RunningAppsPanel" />
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="手动添加进程名（未启动的游戏或程序也可提前加入）" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BlacklistInputBox" Grid.Column="0"
                                             ToolTip="输入进程名（带不带 .exe 均可），例如 YuanShen.exe 或 Weixin"
                                             KeyDown="OnBlacklistInputKeyDown" />
                                    <Button Grid.Column="1" Content="添加" Style="{StaticResource FlatButton}"
                                            Padding="16,0" MinHeight="34" Margin="8,0,0,0" Click="OnAddBlacklistClick" />
                                </Grid>

                                <TextBlock x:Name="BlacklistSummaryText" Text="已加入黑名单的程序" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,6" />
                                <WrapPanel x:Name="BlacklistTagsPanel" />
                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="按需检测：仅在按下热键瞬间读取当前前台进程名，不常驻后台轮询、不增加待机内存。" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 5. 朗读与关于 ==================== -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="语音朗读与关于" Style="{StaticResource PageHeader}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="离线语音朗读" Style="{StaticResource SectionTitle}" />

                                <CheckBox x:Name="TtsEnabledBox" Margin="0,0,0,12"
                                          Content="在浮窗上显示朗读按钮" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="中文音色" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Row="0" Grid.Column="1" x:Name="TtsVoiceZhBox"
                                              Width="260" HorizontalAlignment="Left" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="英文音色" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                                    <ComboBox PreviewMouseWheel="OnComboWheel" Grid.Row="1" Grid.Column="1" x:Name="TtsVoiceEnBox"
                                              Width="260" HorizontalAlignment="Left" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="语速" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="TtsRateSlider" PreviewMouseWheel="OnComboWheel"
                                                Minimum="-50" Maximum="100" Value="0" Width="260"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnTtsRateChanged" />
                                        <TextBlock x:Name="TtsRateLabel" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" Text="常速" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource NoteBox}">
                                    <TextBlock x:Name="TtsHint" Style="{StaticResource Hint}"
                                               Text="使用 Windows 自带语音包，完全离线；想增加更多音色可在系统「设置 → 时间和语言 → 语音」中添加。" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="关于与更新" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,2,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="当前版本" Style="{StaticResource FieldLabel}" Width="112" />
                                        <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="{DynamicResource FontSizeBase}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center" Text="—" />
                                    </StackPanel>
                                    <Button x:Name="CheckUpdateButton" Content="检查更新"
                                            HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                                            Padding="14,6" Click="OnCheckUpdateClick" />
                                </Grid>

                                <TextBlock x:Name="UpdateHint" Style="{StaticResource Hint}"
                                           Margin="0,0,0,10" Text="" />

                                <CheckBox x:Name="HistoryEnabledBox" Margin="0,0,0,14"
                                          Content="记录最近 100 条翻译历史（仅保存在本地 history.json，不占待机内存）" />

                                <StackPanel Orientation="Horizontal">
                                    <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Padding="14,6.5"
                                            Click="OnOpenHistoryClick">
                                        <StackPanel Orientation="Horizontal">
                                            <v:VectorIcon Data="{StaticResource IconHistory}" Size="14.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="查看翻译历史" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Padding="14,6.5" Margin="10,0,0,0"
                                            Click="OnOpenWelcomeClick">
                                        <StackPanel Orientation="Horizontal">
                                            <v:VectorIcon Data="{StaticResource IconBook}" Size="14.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="查看使用引导" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="SaveHint" FontSize="{DynamicResource FontSizeHint}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource FlatButton}" Padding="16,7.5"
                            Click="OnCancelClick" />
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
