<Window x:Class="QuickTrans.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:v="clr-namespace:QuickTrans.Views"
        Title="QuickTrans 翻译历史"
        Width="660" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7FA"
        FontFamily="{StaticResource UiFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <sys:Double x:Key="FontSizeXs">11.5</sys:Double>
        <sys:Double x:Key="FontSizeSm">12.5</sys:Double>
        <sys:Double x:Key="FontSizeBase">13.5</sys:Double>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索与清空 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SearchBorder" Grid.Column="0" CornerRadius="8" BorderThickness="1" Padding="10,6" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <v:VectorIcon x:Name="SearchIcon" Grid.Column="0" Data="{StaticResource IconSearch}" Size="14"
                                  Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="{DynamicResource FontSizeBase}"
                                 VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索原文或译文…" FontSize="{DynamicResource FontSizeBase}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
            <Button x:Name="ClearAllButton" Grid.Column="1" Style="{StaticResource PillBtn}"
                    Padding="14,6" Click="OnClearAllClick">
                <StackPanel Orientation="Horizontal">
                    <v:VectorIcon Data="{StaticResource IconTrash}" Size="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="清空历史" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 列表 -->
        <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListPanel" />
        </ScrollViewer>

        <!-- 底部状态 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center" />
            <Button x:Name="CloseBtn" Content="关闭" Style="{StaticResource PillBtn}" Padding="18,6"
                    HorizontalAlignment="Right" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
