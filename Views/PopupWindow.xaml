<Window x:Class="QuickTrans.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTrans"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MaxHeight="700"
        Width="520"
        Opacity="1"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border x:Name="RootBorder" CornerRadius="12" Background="#FFFFFF" BorderBrush="#DCDCE2" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="18,13,18,13">

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FB" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="EngineText" Text="本地模型" FontSize="11" Foreground="#3B5BA8" />
                    </Border>
                    <TextBlock x:Name="StatusText" Text="正在取词…" FontSize="11"
                               Foreground="#8A8A93" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="OcrButton" Background="Transparent" BorderThickness="0"
                            Padding="8,1" Cursor="Hand" Click="OnOcrClick"
                            ToolTip="框选屏幕区域识别后翻译">
                        <StackPanel>
                            <TextBlock Text="截图" FontSize="11.5" Foreground="#5A5A64"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Alt+S" FontSize="9" Foreground="#ABABB4"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton" Content="✕" Width="24" Height="24" FontSize="11"
                            Foreground="#9A9AA3" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="OnCloseClick" ToolTip="关闭" Margin="6,0,0,0" VerticalAlignment="Top" />
                </StackPanel>
            </Grid>

            <Border x:Name="SourcePanel" Background="#F6F6F8" CornerRadius="6"
                    Padding="11,8" Margin="0,9,0,0">
                <TextBlock x:Name="SourceText" Text="" FontSize="12.5" Foreground="#6E6E78"
                           TextWrapping="Wrap" LineHeight="19" MaxHeight="60" />
            </Border>

            <Border x:Name="InputPanel" Visibility="Collapsed" Background="#F6F6F8"
                    CornerRadius="6" Padding="11,8" Margin="0,9,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" Text="" BorderThickness="0"
                             Background="Transparent" FontSize="13.5" Foreground="#1A1A1E"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="OnInputKeyDown" />
                    <Button x:Name="InputSubmitButton" Grid.Column="1" Background="#3B5BA8"
                            BorderThickness="0" Padding="13,3" Cursor="Hand"
                            VerticalAlignment="Bottom" Margin="10,0,0,0"
                            Click="OnInputSubmitClick" ToolTip="翻译输入框里的内容">
                        <StackPanel>
                            <TextBlock Text="翻译" FontSize="11.5" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Ctrl+Enter" FontSize="9" Foreground="#D3DCF0"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 操作栏：放在原文和译文之间，位置固定。
                 译文不管多长都在它下方增长，按钮不会被挤走。 -->
            <Grid Margin="0,10,0,0" x:Name="FooterPanel" Visibility="Collapsed">
                <StackPanel x:Name="LangPanel" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SpeakButton" Content="🔊" FontSize="12" Foreground="#5A5A64"
                            Background="#F2F2F5" BorderThickness="0" Padding="8,3" Cursor="Hand"
                            Margin="0,0,6,0" ToolTip="朗读译文" Click="OnSpeakClick" />
                    <Button x:Name="CopyButton" Content="复制译文" FontSize="11.5" Foreground="#5A5A64"
                            Background="#F2F2F5" BorderThickness="0" Padding="10,4" Cursor="Hand"
                            Click="OnCopyClick" />
                    <Button x:Name="SettingsButton" Content="⚙" FontSize="12.5" Foreground="#5A5A64"
                            Background="#F2F2F5" BorderThickness="0" Padding="8,3" Cursor="Hand"
                            Margin="6,0,0,0" ToolTip="打开设置" Click="OnSettingsClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ResultScroll" MaxHeight="380" Margin="0,11,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ResultText" Text="" FontSize="16" Foreground="#1A1A1E"
                           TextWrapping="Wrap" LineHeight="25" />
            </ScrollViewer>

            <Border x:Name="LangEditPanel" Visibility="Collapsed" Background="#F6F6F8"
                    CornerRadius="6" Padding="11,9" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="选择要显示在浮窗上的语言，点一下切换" FontSize="11.5"
                               Foreground="#6E6E78" Margin="0,0,0,8" />
                    <ItemsControl x:Name="LangEditList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="取消" FontSize="11.5" Foreground="#5A5A64"
                                Background="#EDEDF1" BorderThickness="0" Padding="14,4" Cursor="Hand"
                                Click="OnCancelLangEditClick" />
                        <Button Content="确定" FontSize="11.5" Foreground="White"
                                Background="#3B5BA8" BorderThickness="0" Padding="16,4" Cursor="Hand"
                                Margin="8,0,0,0" Click="OnConfirmLangEditClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
