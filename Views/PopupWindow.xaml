<Window x:Class="QuickTrans.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:QuickTrans.Views"
        Title="QuickTrans"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MaxHeight="760"
        Width="580"
        Opacity="1"
        FontFamily="{StaticResource UiFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 圆角胶囊按钮：彻底去掉 WPF 默认硬朗的直角悬停框 -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部幽灵图标/快捷按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14808090" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24808090" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="14" Background="#FFFFFF" BorderBrush="#E2E4EC" BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="16,12,16,14">

            <!-- 顶部栏：左侧引擎胶囊 + 状态；右侧快捷操作 -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="EngineBadge" Background="#EAF0FC" CornerRadius="6" Padding="9,3.5">
                        <TextBlock x:Name="EngineText" Text="本地模型" FontSize="12" FontWeight="SemiBold" Foreground="#3B5BA8" />
                    </Border>
                    <TextBlock x:Name="StatusText" Text="正在取词…" FontSize="12"
                               Foreground="#646876" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ReplaceButton" Style="{StaticResource GhostButton}"
                            Padding="8,2.5" Click="OnReplaceClick" Visibility="Collapsed"
                            ToolTip="用当前译文替换原窗口中选中的文字">
                        <StackPanel>
                            <TextBlock x:Name="ReplaceBtnTitle" Text="替换" FontSize="12.5" FontWeight="Medium" Foreground="#3A3D4A"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="ReplaceHotkeyHint" Text="Alt+R" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="#646876"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OcrButton" Style="{StaticResource GhostButton}"
                            Padding="8,2.5" Click="OnOcrClick" Margin="2,0,0,0"
                            ToolTip="框选屏幕区域识别后翻译">
                        <StackPanel>
                            <TextBlock x:Name="OcrBtnTitle" Text="截图" FontSize="12.5" FontWeight="Medium" Foreground="#3A3D4A"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="OcrHotkeyHint" Text="Alt+S" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="#646876"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryButton" Style="{StaticResource GhostButton}"
                            Width="30" Height="30" Foreground="#646876"
                            Click="OnHistoryClick" ToolTip="查看翻译历史" Margin="3,0,0,0">
                        <v:VectorIcon Data="{StaticResource IconHistory}" Size="15.5" />
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource GhostButton}"
                            Width="30" Height="30" Foreground="#646876" Opacity="0.72"
                            Click="OnPinClick" ToolTip="钉住浮窗（暂不自动关闭）" Margin="2,0,0,0">
                        <v:VectorIcon Data="{StaticResource IconPin}" Size="15.5" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource GhostButton}"
                            Width="30" Height="30" Foreground="#646876"
                            Click="OnCloseClick" ToolTip="关闭 (Esc)" Margin="2,0,0,0">
                        <v:VectorIcon Data="{StaticResource IconClose}" Size="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 原文区：左侧细主题竖条 + 可平滑滚动容器（长文不截断） -->
            <Border x:Name="SourcePanel" Background="#F4F5F8" CornerRadius="8"
                    Padding="0" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SourceAccentBar" Grid.Column="0" Background="#3B5BA8" CornerRadius="3,0,0,3" Opacity="0.65" />
                    <ScrollViewer x:Name="SourceScroll" Grid.Column="1" MaxHeight="96"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="11,8,11,8">
                        <TextBlock x:Name="SourceText" Text="" FontSize="13.5" Foreground="#5A5C68"
                                   TextWrapping="Wrap" LineHeight="21" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 手动输入区 -->
            <Border x:Name="InputPanel" Visibility="Collapsed" Background="#F4F5F8"
                    CornerRadius="8" Padding="11,8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" Text="" BorderThickness="0"
                             Background="Transparent" FontSize="14.5" Foreground="#1A1A1E"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="OnInputKeyDown" />
                    <Button x:Name="InputSubmitButton" Grid.Column="1" Style="{StaticResource PillButton}"
                            Background="#3B5BA8" Padding="14,5" VerticalAlignment="Bottom" Margin="10,0,0,0"
                            Click="OnInputSubmitClick" ToolTip="翻译输入框里的内容">
                        <StackPanel>
                            <TextBlock Text="翻译" FontSize="12.5" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Ctrl+Enter" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9" Foreground="#D3DCF0"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 固定操作栏：左语言切换（自动换行不重叠），右场景预设（翻译/润色/解释）+ 朗读/复制/设置 -->
            <DockPanel Margin="0,10,0,0" x:Name="FooterPanel" Visibility="Collapsed" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- 场景模式切换：仅本地模型与 OpenAI 接口可见 -->
                    <Border x:Name="ModePanel" Background="#F0F1F5" CornerRadius="6" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ModeTranslateBtn" Content="翻译" Style="{StaticResource PillButton}"
                                    FontSize="12" Padding="10,4" Tag="translate" Click="OnModeClick"
                                    ToolTip="翻译模式" />
                            <Button x:Name="ModePolishBtn" Content="润色" Style="{StaticResource PillButton}"
                                    FontSize="12" Padding="10,4" Tag="polish" Click="OnModeClick"
                                    ToolTip="润色优化（更地道流畅）" />
                            <Button x:Name="ModeExplainBtn" Content="解释" Style="{StaticResource PillButton}"
                                    FontSize="12" Padding="10,4" Tag="explain" Click="OnModeClick"
                                    ToolTip="简明解释（术语 / 报错 / 代码）" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="SpeakButton" Style="{StaticResource PillButton}"
                            Foreground="#525460" Background="#F0F1F5" Padding="9,5.5" Margin="0,0,5,0"
                            ToolTip="朗读译文" Click="OnSpeakClick">
                        <v:VectorIcon Data="{StaticResource IconVolume}" Size="15" />
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource PillButton}" FontSize="12.5"
                            Foreground="#525460" Background="#F0F1F5" Padding="11,5" Margin="0,0,5,0"
                            Click="OnCopyClick">
                        <StackPanel Orientation="Horizontal">
                            <v:VectorIcon Data="{StaticResource IconCopy}" Size="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CopyBtnText" Text="复制" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource PillButton}"
                            Foreground="#525460" Background="#F0F1F5" Padding="9,5.5"
                            ToolTip="打开设置" Click="OnSettingsClick">
                        <v:VectorIcon Data="{StaticResource IconSettings}" Size="15" />
                    </Button>
                </StackPanel>

                <WrapPanel x:Name="LangPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>

            <!-- 细分隔线 -->
            <Border x:Name="ResultDivider" Height="1" Background="#ECEDF2" Margin="0,10,0,0" />

            <!-- 译文展示区 -->
            <ScrollViewer x:Name="ResultScroll" MaxHeight="400" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ResultText" Text="" FontSize="16.5" Foreground="#1A1A1E"
                           TextWrapping="Wrap" LineHeight="27" />
            </ScrollViewer>

            <!-- 快捷语言编辑面板 -->
            <Border x:Name="LangEditPanel" Visibility="Collapsed" Background="#F4F5F8"
                    CornerRadius="8" Padding="11,9" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="LangEditHint" Text="选择要显示在浮窗上的语言，点一下切换" FontSize="12"
                               Foreground="#6E6E78" Margin="0,0,0,8" />
                    <ItemsControl x:Name="LangEditList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="CancelLangBtn" Style="{StaticResource PillButton}" Content="取消" FontSize="12"
                                Foreground="#525460" Background="#E6E7EE" Padding="14,4.5"
                                Click="OnCancelLangEditClick" />
                        <Button x:Name="ConfirmLangBtn" Style="{StaticResource PillButton}" Content="确定" FontSize="12"
                                Foreground="White" Background="#3B5BA8" Padding="16,4.5"
                                Margin="8,0,0,0" Click="OnConfirmLangEditClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
